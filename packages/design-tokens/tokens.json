{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Aido DS",
  "version": "0.1.0",
  "description": "Single source of truth for Aido design tokens. Generates Tailwind theme (web) + NativeWind theme (Expo). Preview: docs/design.html",
  "color": {
    "light": {
      "background": "#f8fafc",
      "surface": "#ffffff",
      "border": "#e2e8f0",
      "text": "#0f172a",
      "textMuted": "#64748b"
    },
    "dark": {
      "background": "#020617",
      "surface": "#0f172a",
      "border": "#1e293b",
      "text": "#f1f5f9",
      "textMuted": "#94a3b8"
    },
    "action": {
      "buy": "#16a34a",
      "buyBg": "#dcfce7",
      "buyFg": "#166534",
      "hold": "#d97706",
      "holdBg": "#fef3c7",
      "holdFg": "#92400e",
      "sell": "#dc2626",
      "sellBg": "#fee2e2",
      "sellFg": "#991b1b",
      "watch": "#2563eb",
      "watchBg": "#dbeafe",
      "watchFg": "#1e40af",
      "neutralBg": "#e2e8f0",
      "neutralFg": "#334155"
    },
    "risk": {
      "highBg": "#fef2f2",
      "highBorder": "#fecaca",
      "highFg": "#b91c1c",
      "medBg": "#fffbeb",
      "medBorder": "#fde68a",
      "medFg": "#b45309",
      "lowBg": "#f0fdf4",
      "lowBorder": "#bbf7d0",
      "lowFg": "#15803d"
    }
  },
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "web": "Inter, system-ui, sans-serif",
    "scale": {
      "display": { "size": 24, "weight": 800, "tracking": -0.02 },
      "title": { "size": 18, "weight": 800 },
      "body": { "size": 14, "weight": 400, "minSp": 14 },
      "caption": { "size": 12, "weight": 500 },
      "numeric": { "size": 14, "weight": 700, "tabularNums": true }
    }
  },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 20, 24, 32] },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 20, "pill": 999 },
  "scoreThresholds": { "buy": 75, "watch": 65, "hold": 50, "sell": 40 },
  "components": {
    "ScoreRing": { "size": 96, "track": "border", "bar": "action.*", "strokeWidth": 10 },
    "ActionBadge": { "variant": ["BUY", "HOLD", "SELL", "WATCH", "NO_SIGNAL"], "shape": "pill" },
    "ConfidencePill": { "variant": ["High", "Med", "Low"] },
    "SuitabilityBadge": { "variant": ["High", "Med", "Low", "Outside Profile"] },
    "AllocationBar": { "height": 8, "shape": "pill" }
  }
}
